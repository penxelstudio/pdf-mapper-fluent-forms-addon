# WordPress coding standards: tabs for indentation, LF, trailing newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.txt]
trim_trailing_whitespace = false

[assets/vendor/**]
insert_final_newline = false
trim_trailing_whitespace = false
